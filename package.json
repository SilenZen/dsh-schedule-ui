{
  "name": "dsh-schedule-ui",
  "version": "0.1.0",
  "description": "定时任务管理界面：会话头部按钮 + 全局浮层面板 + 侧边栏分区，为 @deepseek-ai/dsh-schedule 提供可视化入口",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "schedule",
    "scheduled-tasks",
    "plugin",
    "dsh-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/SilenZen/dsh-schedule-ui.git"
  },
  "homepage": "https://github.com/SilenZen/dsh-schedule-ui",
  "bugs": {
    "url": "https://github.com/SilenZen/dsh-schedule-ui/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
